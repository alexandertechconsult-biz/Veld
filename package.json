{
  "name": "veld",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first farm record-keeping PWA for a single mixed crop-and-livestock operation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record:e2e": "bash .claude/skills/ralph-loop/scripts/record_e2e.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
